rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/cute-science-temp-app/public/data/temperature-data/{sessionId}/groups/{groupId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'name',
          'hotWater',
          'coldWater',
          'timerStartTime',
          'timerElapsed',
          'members',
          'predictionCold',
          'predictionHot',
          'predictionReason',
          'particleModelUnlocked',
          'quizCompleted'
        ]);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
