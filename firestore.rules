rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 이 앱에서 실제 수업 기록이 저장되는 경로입니다.
    match /artifacts/cute-science-temp-app/public/data/temperature-data/{sessionId}/groups/{groupId} {

      // 학생과 선생님 모두 현재 수업의 기록을 읽을 수 있습니다.
      allow read: if request.auth != null;

      // 선생님 계정: Firebase 이메일/비밀번호 계정으로 로그인한 사용자.
      // 앱에서는 이 계정을 선생님 화면에서만 사용합니다.
      allow create, update, delete: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';

      // 학생 계정: 익명 로그인 사용자는 한 번에 하나의 최상위 필드만 바꿀 수 있습니다.
      // 따라서 학생이 여러 필드를 한꺼번에 지우는 '전체 초기화' 쓰기는 허용되지 않습니다.
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().size() == 1
        && request.resource.data.keys().hasOnly([
          'name',
          'hotWater',
          'coldWater',
          'timerStartTime',
          'members',
          'quizCompleted'
        ]);

      allow update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'hotWater',
          'coldWater',
          'timerStartTime',
          'members',
          'quizCompleted'
        ]);
    }

    // 위 경로 이외의 Firestore 데이터는 웹 클라이언트에서 접근할 수 없습니다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
